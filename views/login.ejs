<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登录 - 教案管理系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="login-header-title">教案管理系统</div>
        <div class="login-header-sub">欢迎回来，请登录你的账号</div>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/login" method="POST" class="login-form" autocomplete="off">
        <div class="form-group">
          <label for="username">用户名</label>
          <input type="text" id="username" name="username" required
                 placeholder="输入用户名" autofocus class="form-input form-input-lg">
        </div>
        <div class="form-group">
          <label for="password">密码</label>
          <input type="password" id="password" name="password" required
                 placeholder="输入密码" class="form-input form-input-lg">
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">登 录</button>
      </form>

      <div class="login-footer">
        <span class="login-footer-version">教案管理系统 v1.0</span>
      </div>
    </div>
  </div>
</body>
</html>
