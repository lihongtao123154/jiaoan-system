<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>注册 - 教案管理系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="login-header-title">创建账号</div>
        <div class="login-header-sub">注册后即可创建和管理教案</div>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/register" method="POST" class="login-form" autocomplete="off">
        <div class="form-group">
          <label for="username">用户名 <span class="required">*</span></label>
          <input type="text" id="username" name="username" required
                 placeholder="至少2个字符" autofocus class="form-input form-input-lg">
        </div>
        <div class="form-group">
          <label for="displayName">显示名称</label>
          <input type="text" id="displayName" name="displayName"
                 placeholder="留空则使用用户名" class="form-input form-input-lg">
        </div>
        <div class="form-group">
          <label for="password">密码 <span class="required">*</span></label>
          <input type="password" id="password" name="password" required
                 placeholder="至少4位" class="form-input form-input-lg">
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">注 册</button>
      </form>

      <div class="login-footer" style="justify-content:center">
        <span>已有账号？</span>
        <a href="/login" style="font-weight:600">立即登录</a>
      </div>
    </div>
  </div>
</body>
</html>
