<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= plan ? '编辑' : '新建' %>教案 - 教案管理系统</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">

</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <div class="nav-brand">
        <span class="nav-brand-logo"></span>
        <span class="nav-title">教案管理系统</span>
      </div>
      <div class="nav-menu">
        <span class="nav-user">
          <span class="user-avatar"><%= user.displayName.charAt(0) %></span>
          <span><%= user.displayName %></span>
        </span>
        <a href="/dashboard" class="nav-link">私人空间</a>
        <a href="/hall" class="nav-link">公共大厅</a>
        <a href="/logout" class="nav-link nav-link-danger">退出</a>
      </div>
      <button class="nav-toggle" onclick="document.querySelector('.nav-menu').classList.toggle('show')">
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </nav>

  <main class="main-content">
    <div class="form-page">
      <div class="page-header">
        <h2><%= plan ? '编辑教案' : '新建教案' %></h2>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="<%= plan ? '/plan/' + plan.id : '/plan' %>" method="POST" class="plan-form" id="planForm">
        <% if (courses && courses.length > 0) { %>
          <div class="form-row">
            <div class="form-group" style="flex:1">
              <label for="courseId">所属课程</label>
              <select id="courseId" name="courseId" class="form-input">
                <option value="">不选择</option>
                <% courses.forEach(function(c) { %>
                  <option value="<%= c.id %>" <%= plan && plan.courseId === c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group" style="flex:1">
              <label for="sessionName">课时名称</label>
              <input type="text" id="sessionName" name="sessionName"
                     value="<%= plan ? plan.sessionName : '' %>"
                     placeholder="如：第1课时、第2课时" class="form-input">
            </div>
          </div>
        <% } %>

        <% if (allTags && allTags.length > 0) { %>
          <div class="form-group">
            <label>标签</label>
            <div class="tag-selector">
              <% allTags.forEach(function(t) { %>
                <label class="tag-option">
                  <input type="checkbox" name="tagIds" value="<%= t.id %>"
                    <%= planTags && planTags.some(function(pt) { return pt.id === t.id }) ? 'checked' : '' %>>
                  <span style="background:<%= t.color || '#3498db' %>"><%= t.name %></span>
                </label>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div class="form-group">
          <label for="title">教案标题 <span class="required">*</span></label>
          <input type="text" id="title" name="title" required
                 value="<%= plan ? plan.title : '' %>"
                 placeholder="给你的教案起个名字" class="form-input form-input-lg">
        </div>

        <div class="form-group">
          <label>教案内容</label>
          <p class="form-help">使用下方编辑器排版，所见即所得</p>
          <div id="editorContainer" class="form-input" style="height:400px"><%= plan ? plan.content : '' %></div>
          <input type="hidden" name="content" id="contentInput">
        </div>

        <div class="form-group">
          <label>附件资源</label>
          <p class="form-help">支持图片、视频、PDF、PPT、Word、Excel、压缩包等，单文件最大 3GB</p>

          <div class="upload-zone" id="uploadZone">
            <div class="upload-zone-label">把文件拖到这里上传</div>
            <div class="upload-zone-hint">或点击选择文件</div>
            <input type="file" id="fileInput" multiple accept="*" hidden>
            <div class="upload-progress" id="uploadProgress" style="display:none">
              <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
              </div>
              <div class="progress-text" id="progressText">上传中...</div>
            </div>
          </div>

          <div class="upload-status" id="uploadStatus"></div>

          <div class="file-list" id="fileList">
            <% if (plan && plan.files) { %>
              <% plan.files.forEach(function(file) { %>
                <div class="file-item" data-filename="<%= file.filename %>" data-type="<%= file.type %>">
                  <span class="file-item-type"><%= file.type === 'image' ? '图片' : file.type === 'video' ? '视频' : '文档' %></span>
                  <span class="file-item-name"><%= file.originalName %></span>
                  <span class="file-item-size"><%= formatFileSize(file.size) %></span>
                  <button type="button" class="file-item-remove" onclick="removeFile(this)" title="移除">&times;</button>
                </div>
              <% }); %>
            <% } %>
          </div>

          <input type="hidden" name="fileList" id="fileListInput"
                 value='<%= plan && plan.files ? JSON.stringify(plan.files).replace(/'/g, "&#39;") : "[]" %>'>
        </div>

        <div class="form-group">
          <label>公开分享</label>
          <label class="switch-label">
            <input type="checkbox" name="isPublic" value="1"
              <%= plan && plan.isPublic == 1 ? 'checked' : '' %>>
            <span class="switch-slider"></span>
            <span class="switch-text">允许其他用户查看此教案</span>
          </label>
          <div class="hint" style="margin-top:4px"><span class="hint-icon">i</span> 开启后教案会出现在「公共大厅」供其他用户浏览、收藏和评论</div>
        </div>

        <div class="form-group">
          <label>封面图片</label>
          <p class="form-help">上传一张封面图，在首页会显示在教案卡片上</p>
          <div class="cover-upload" id="coverUpload">
            <% if (plan && plan.coverUrl) { %>
              <img src="<%= plan.coverUrl %>" class="cover-preview" id="coverPreview">
            <% } else { %>
              <img src="" class="cover-preview" id="coverPreview" style="display:none">
            <% } %>
            <div class="cover-actions">
              <button type="button" class="btn btn-sm btn-outline" onclick="document.getElementById('coverInput').click()">选择图片</button>
              <button type="button" class="btn btn-sm btn-danger" id="removeCoverBtn" style="display:<%= plan && plan.coverUrl ? 'inline-block' : 'none' %>" onclick="removeCover()">移除</button>
            </div>
            <input type="file" id="coverInput" accept="image/*" hidden>
            <input type="hidden" name="coverUrl" id="coverUrlInput" value="<%= plan ? plan.coverUrl : '' %>">
          </div>
        </div>

        <div class="form-actions">
          <a href="/dashboard" class="btn btn-outline btn-lg">取消</a>
          <button type="submit" class="btn btn-primary btn-lg" id="saveBtn">
            <%= plan ? '保存修改' : '创建教案' %>
          </button>
        </div>
      </form>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.min.js"></script>
  <script src="/js/main.js"></script>
  <script>
    // Quill 编辑器
    const quill = new Quill('#editorContainer', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ['bold', 'italic', 'underline', 'strike'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          [{ indent: '-1' }, { indent: '+1' }],
          [{ align: [] }],
          ['blockquote', 'code-block'],
          [{ color: [] }, { background: [] }],
          ['link'],
          ['clean']
        ]
      }
    });

    // 封面上传
    document.getElementById('coverInput').addEventListener('change', function() {
      if (this.files.length === 0) return;
      const file = this.files[0];
      if (file.size > 5 * 1024 * 1024) { alert('封面图不能超过 5MB'); return; }
      const formData = new FormData();
      formData.append('file', file);
      const xhr = new XMLHttpRequest();
      xhr.addEventListener('load', function() {
        if (xhr.status === 200) {
          try {
            const resp = JSON.parse(xhr.responseText);
            if (resp.success) {
              document.getElementById('coverUrlInput').value = resp.file.url || '/uploads/images/' + resp.file.filename;
              document.getElementById('coverPreview').src = resp.file.url || '/uploads/images/' + resp.file.filename;
              document.getElementById('coverPreview').style.display = 'block';
              document.getElementById('removeCoverBtn').style.display = 'inline-block';
            } else { alert(resp.error || '上传失败'); }
          } catch(e) { alert('上传失败'); }
        } else { alert('上传失败'); }
      });
      xhr.open('POST', '/upload', true);
      xhr.send(formData);
    });

    function removeCover() {
      document.getElementById('coverUrlInput').value = '';
      document.getElementById('coverPreview').src = '';
      document.getElementById('coverPreview').style.display = 'none';
      document.getElementById('removeCoverBtn').style.display = 'none';
    }

    document.getElementById('planForm').addEventListener('submit', function(e) {
      document.getElementById('contentInput').value = quill.root.innerHTML;
      const btn = document.getElementById('saveBtn');
      btn.disabled = true;
      btn.textContent = '保存中...';
    });

    // 文件上传
    const uploadedFiles = (function() {
      try {
        const input = document.getElementById('fileListInput');
        return JSON.parse(input.value || '[]');
      } catch(e) { return []; }
    })();

    function updateFileListInput() {
      document.getElementById('fileListInput').value = JSON.stringify(uploadedFiles);
    }

    function addFileItem(file) {
      uploadedFiles.push(file);
      updateFileListInput();
      const container = document.getElementById('fileList');
      const div = document.createElement('div');
      div.className = 'file-item';
      div.dataset.filename = file.filename;
      div.dataset.type = file.type;
      div.innerHTML =
        '<span class="file-item-type">' + (file.type === 'image' ? '图片' : file.type === 'video' ? '视频' : '文档') + '</span>' +
        '<span class="file-item-name">' + file.originalName + '</span>' +
        '<span class="file-item-size">' + formatFileSize(file.size) + '</span>' +
        '<button type="button" class="file-item-remove" onclick="removeFile(this)" title="移除">&times;</button>';
      container.appendChild(div);
    }

    function removeFile(btn) {
      const item = btn.closest('.file-item');
      const filename = item.dataset.filename;
      const type = item.dataset.type;
      const idx = uploadedFiles.findIndex(function(f) { return f.filename === filename; });
      if (idx !== -1) uploadedFiles.splice(idx, 1);
      updateFileListInput();
      item.remove();
      fetch('/upload/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filename: filename, type: type })
      }).catch(function() {});
    }

    const uploadZone = document.getElementById('uploadZone');
    const fileInput = document.getElementById('fileInput');

    uploadZone.addEventListener('click', function() { fileInput.click(); });

    uploadZone.addEventListener('dragover', function(e) {
      e.preventDefault();
      this.classList.add('drag-over');
    });

    uploadZone.addEventListener('dragleave', function(e) {
      e.preventDefault();
      this.classList.remove('drag-over');
    });

    uploadZone.addEventListener('drop', function(e) {
      e.preventDefault();
      this.classList.remove('drag-over');
      if (e.dataTransfer.files.length > 0) uploadFiles(e.dataTransfer.files);
    });

    fileInput.addEventListener('change', function() {
      if (this.files.length > 0) { uploadFiles(this.files); this.value = ''; }
    });

    function getFileType(file) {
      if (file.type.startsWith('image/')) return 'image';
      if (file.type.startsWith('video/')) return 'video';
      return 'document';
    }

    function uploadFiles(files) {
      const progress = document.getElementById('uploadProgress');
      const progressFill = document.getElementById('progressFill');
      const progressText = document.getElementById('progressText');

      Array.from(files).forEach(function(file) {
        if (file.size > 3 * 1024 * 1024 * 1024) {
          showStatus(file.name + ' 超过 3GB 限制', 'error');
          return;
        }
        progress.style.display = 'block';
        uploadZone.classList.add('uploading');

        var formData = new FormData();
        formData.append('file', file);

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/cos/upload', true);

        xhr.upload.addEventListener('progress', function(e) {
          if (e.lengthComputable) {
            var pct = parseInt(e.loaded / e.total * 100, 10);
            progressFill.style.width = pct + '%';
            progressText.textContent = file.name + ' - ' + pct + '%';
          }
        });

        xhr.addEventListener('load', function() {
          progress.style.display = 'none';
          uploadZone.classList.remove('uploading');
          try {
            var resp = JSON.parse(xhr.responseText);
            if (resp.success) {
              addFileItem(resp.file);
              showStatus(file.name + ' 上传成功', 'success');
            } else {
              showStatus(file.name + ': ' + (resp.error || '上传失败'), 'error');
            }
          } catch(e) {
            showStatus(file.name + ': 上传失败', 'error');
          }
        });

        xhr.addEventListener('error', function() {
          progress.style.display = 'none';
          uploadZone.classList.remove('uploading');
          showStatus(file.name + ': 网络错误', 'error');
        });

        xhr.send(formData);
      });
    }

    function showStatus(msg, type) {
      const status = document.getElementById('uploadStatus');
      const div = document.createElement('div');
      div.className = 'status-msg status-' + (type || 'info');
      div.textContent = msg;
      status.appendChild(div);
      setTimeout(function() {
        div.style.opacity = '0';
        setTimeout(function() { div.remove(); }, 500);
      }, 4000);
    }
  </script>
</body>
</html>
